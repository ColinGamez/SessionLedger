# ============================================================
# LedgerStack — Environment Variables
# Copy to .env.local for local development
# Set ALL variables in Vercel project settings for production
# ============================================================

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: https://yourdomain.com

# ---- Supabase (public — safe to expose to browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# ---- Supabase (server-only — NEVER expose to client) ----
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
# Used only in: stripe webhook, admin scripts
# Never import this in 'use client' files or components

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_live_...
# Test: sk_test_...

STRIPE_WEBHOOK_SECRET=whsec_...
# Get from: stripe listen --forward-to localhost:3000/api/stripe/webhook
# Production: set in Stripe Dashboard > Developers > Webhooks

STRIPE_PRO_MONTHLY_PRICE_ID=price_...
# Create in Stripe Dashboard > Products

# ---- Optional: Email (e.g. Resend) ----
# RESEND_API_KEY=re_...
# FROM_EMAIL=noreply@yourdomain.com
